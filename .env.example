# App
APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-string

# Database
POSTGRES_PASSWORD=stocksoup

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Auth (Phase 2 — leave as-is for Phase 1)
NEXTAUTH_SECRET=change-this-to-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Binance Testnet — fake money, safe for development
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET_KEY=

# Binance Live — DO NOT fill until testnet is profitable for 30+ days
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_SECRET_KEY=

# Trading mode: testnet | paper | live
TRADING_MODE=testnet

# Risk limits (enforced in code)
MAX_RISK_PER_TRADE_PCT=1.0
MAX_PORTFOLIO_DRAWDOWN_PCT=10.0
MAX_CONCURRENT_POSITIONS=3
